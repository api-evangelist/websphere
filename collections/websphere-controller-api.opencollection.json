{
  "opencollection": "1.0.0",
  "info": {
    "name": "Open Liberty APIs Applications Controller API",
    "version": "24.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Controller",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Controller Information",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://localhost:9443/controller"
          },
          "docs": "Returns information about the collective controller."
        }
      ]
    }
  ],
  "bundled": true
}